+      color: var(--cw-accent);
+    }
+  }
+
+  &.cw-callout-success {
+    background: var(--cw-success-bg, rgba(46, 125, 50, 0.08));
+    border-color: rgba(46, 125, 50, 0.25);
+    color: var(--cw-text-primary);
+    .cw-callout-icon {
+      color: var(--cw-success, #2e7d32);
+    }
+  }
+
+  &.cw-callout-warning {
+    background: var(--cw-warning-bg, rgba(230, 126, 34, 0.1));
+    border-color: rgba(230, 126, 34, 0.3);
+    color: var(--cw-text-primary);
+    .cw-callout-icon {
+      color: #d35400;
+    }
+  }
+
+  &.cw-callout-danger {
+    background: var(--cw-danger-bg, rgba(192, 57, 43, 0.08));
+    border-color: rgba(192, 57, 43, 0.25);
+    color: var(--cw-danger, #c0392b);
